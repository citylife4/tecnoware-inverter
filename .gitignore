__pycache__/
*.pyc
.DS_Store

# runtime state, not source
.charge_schedule_state.json
charge_schedule.log
charge_schedule.err

# web server config -- contains the API token and session secret
web.json
web.log

# built-in scheduler's rule storage -- instance-specific runtime config
web_schedule.json
web_schedule.json.tmp

# grid-export charge controller's config -- instance-specific runtime config
web_gridcharge.json
web_gridcharge.json.tmp

# last-known POP/PCP priority values -- instance-specific runtime state
web_priorities.json
web_priorities.json.tmp

# telemetria persistente (CSV diario) -- dados de execucao, nao fonte
telemetry/

# saida do teste supervisionado de bateria (battery_test.py) -- execucao, nao fonte
battery_test.csv
battery_test.log

# nightly battery window's config + runtime latch state -- instance-specific
web_battery_window.json
web_battery_window.json.tmp
web_battery_window.json.state
web_battery_window.json.state.tmp

# persistent write audit -- instance-specific runtime state
web_audit.json
web_audit.json.tmp

# estado do notificador (ultima condicao comunicada) -- execucao, nao fonte
.notify_state.json
.notify_state.json.tmp
